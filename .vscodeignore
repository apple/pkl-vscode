**/*

!CHANGELOG.md
!README.md
!language-configuration.json
!package.json
!out/**/!(*.map)
!queries/*
!img/*
!LICENSE

# vsce only collects production dependencies (`npm list --production`),
# so dev dependencies are never packaged.
!node_modules/!(web-tree-sitter)/**/!(*.map|*.d.ts)

# web-tree-sitter also ships debug builds, C sources, and an ESM build
# only the CommonJS build and its wasm are loaded at runtime.
!node_modules/web-tree-sitter/package.json
!node_modules/web-tree-sitter/LICENSE
!node_modules/web-tree-sitter/tree-sitter.cjs
!node_modules/web-tree-sitter/tree-sitter.wasm
